@{
    Layout = null;
    ViewData["Title"] = "Sign in";
    var initialMode = ViewData["InitialMode"] as string ?? "login";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connectly — Sign in</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/connectly.css" asp-append-version="true" />
</head>
<body data-initial-mode="@initialMode">
<div class="auth-page">
    <section class="auth-brand">
        <div>
            <div class="sidebar-brand" style="padding:0;margin:0">
                <span class="brand-icon">C</span>
                <div class="brand-text"><h1 style="color:#fff">Connectly</h1></div>
            </div>
            <h1>Connect, share, and celebrate with your inner circle in real-time.</h1>
            <p>Join the network designed for high-utility professional and creative social management.</p>
        </div>
        <p style="opacity:0.75;font-size:0.88rem;margin:0">Private by design · Built for connection</p>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-wrap">
            <div class="auth-tabs">
                <button type="button" class="auth-tab active" data-mode="login">Sign In</button>
                <button type="button" class="auth-tab" data-mode="register">Create Account</button>
            </div>

            <h2 id="auth-heading" class="auth-title">Welcome back</h2>
            <p id="auth-copy" class="auth-subtitle">Enter your details to access your account.</p>

            <form id="login-form" class="auth-form" novalidate>
                <div id="login-form-alert" class="form-alert d-none" role="alert"></div>
                <div class="form-group">
                    <label class="form-label" for="login-identifier">Username or email</label>
                    <input id="login-identifier" type="text" name="login" autocomplete="username" placeholder="yourname or you@example.com" class="form-control" />
                </div>
                <div class="form-group">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem">
                        <label class="form-label" for="login-password" style="margin:0">Password</label>
                        <button type="button" id="show-forgot" class="text-muted" style="background:none;border:none;font-size:0.82rem;color:var(--accent);cursor:pointer;font-weight:600">Forgot password?</button>
                    </div>
                    <input id="login-password" type="password" name="password" autocomplete="current-password" placeholder="Password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary btn-auth">Sign In to Connectly</button>
            </form>

            <form id="forgot-form" class="auth-form d-none" novalidate>
                <div id="forgot-form-alert" class="form-alert d-none" role="alert"></div>
                <div class="form-group">
                    <label class="form-label" for="forgot-login">Username or email</label>
                    <input id="forgot-login" required type="text" name="login" autocomplete="username" placeholder="yourname or you@example.com" class="form-control" />
                    <p class="field-error d-none" data-error-for="login"></p>
                </div>
                <p class="text-muted" style="font-size:0.85rem;margin:0 0 1rem">We'll email a 6-digit verification code to the address on your account.</p>
                <button type="submit" class="btn btn-primary btn-auth">Send verification code</button>
                <button type="button" id="back-to-login" class="btn btn-light btn-auth mt-3">Back to sign in</button>
            </form>

            <form id="forgot-reset-form" class="auth-form d-none" novalidate>
                <div id="forgot-reset-form-alert" class="form-alert d-none" role="alert"></div>
                <input type="hidden" id="forgot-reset-login" name="login" />
                <p class="text-muted" style="font-size:0.88rem;margin:0 0 1rem">Enter the code from your email and choose a new password.</p>
                <div class="form-group">
                    <label class="form-label" for="forgot-reset-code">Verification code</label>
                    <input id="forgot-reset-code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="code" autocomplete="one-time-code" placeholder="123456" class="form-control" />
                    <p class="field-error d-none" data-error-for="code"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="forgot-reset-password">New password</label>
                    <input id="forgot-reset-password" required minlength="6" type="password" name="newPassword" autocomplete="new-password" class="form-control" />
                    <p class="field-error d-none" data-error-for="newPassword"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="forgot-reset-confirm">Confirm password</label>
                    <input id="forgot-reset-confirm" required minlength="6" type="password" name="confirmPassword" autocomplete="new-password" class="form-control" />
                    <p class="field-error d-none" data-error-for="confirmPassword"></p>
                </div>
                <button type="submit" class="btn btn-primary btn-auth">Update password</button>
                <button type="button" id="back-from-forgot-reset" class="btn btn-light btn-auth mt-3">Back</button>
            </form>

            <form id="register-form" class="auth-form d-none" novalidate>
                <div id="register-form-alert" class="form-alert d-none" role="alert"></div>
                <div class="form-group">
                    <label class="form-label" for="register-name">Full Name</label>
                    <input id="register-name" required minlength="2" maxlength="100" name="name" autocomplete="name" placeholder="Your full name" class="form-control" />
                    <p class="field-error d-none" data-error-for="name"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="register-username">Username</label>
                    <input id="register-username" required minlength="3" maxlength="30" name="username" autocomplete="username" placeholder="yourname" pattern="[a-zA-Z0-9._]+" class="form-control" />
                    <small class="field-hint">3–30 characters. Letters, numbers, dots, and underscores only.</small>
                    <p class="field-error d-none" data-error-for="username"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="register-email">Email Address</label>
                    <input id="register-email" required type="email" name="email" autocomplete="email" placeholder="you@example.com" class="form-control" />
                    <p class="field-error d-none" data-error-for="email"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="register-password">Password</label>
                    <input id="register-password" required minlength="6" type="password" name="password" autocomplete="new-password" placeholder="At least 6 characters" class="form-control" />
                    <p class="field-error d-none" data-error-for="password"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="register-confirm-password">Confirm Password</label>
                    <input id="register-confirm-password" required minlength="6" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Re-enter your password" class="form-control" />
                    <p class="field-error d-none" data-error-for="confirmPassword"></p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="register-birthday">Birthday</label>
                    <input id="register-birthday" required type="date" name="dateOfBirth" class="form-control" />
                    <p class="field-error d-none" data-error-for="dateOfBirth"></p>
                </div>
                <button type="submit" class="btn btn-primary btn-auth">Create Account</button>
            </form>

            <form id="verify-email-form" class="auth-form d-none" novalidate>
                <div id="verify-form-alert" class="form-alert d-none" role="alert"></div>
                <p class="text-muted" style="font-size:0.88rem;margin:0 0 1rem">
                    We sent a 6-digit code to <strong id="verify-email-display"></strong>. Enter it below to verify your account.
                </p>
                <input type="hidden" id="verify-email-hidden" name="email" />
                <div class="form-group">
                    <label class="form-label" for="verify-code">Verification code</label>
                    <input id="verify-code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="code" autocomplete="one-time-code" placeholder="123456" class="form-control" />
                    <p class="field-error d-none" data-error-for="code"></p>
                </div>
                <button type="submit" class="btn btn-primary btn-auth">Verify &amp; continue</button>
                <button type="button" id="resend-verification" class="btn btn-light btn-auth mt-3">Resend code</button>
                <button type="button" id="back-from-verify" class="btn btn-light btn-auth mt-2">Back</button>
            </form>
        </div>
    </section>
</div>
<div id="toast-host" class="toast-host"></div>
<script src="~/js/auth-page.js" asp-append-version="true"></script>
</body>
</html>
