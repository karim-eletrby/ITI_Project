@{
    Layout = null;
    ViewData["Title"] = "Reset password";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connectly — Reset password</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/connectly.css" asp-append-version="true" />
</head>
<body>
<div class="auth-page">
    <section class="auth-brand">
        <div>
            <div class="sidebar-brand" style="padding:0;margin:0">
                <span class="brand-icon">C</span>
                <div class="brand-text"><h1 style="color:#fff">Connectly</h1></div>
            </div>
            <h1>Choose a new password</h1>
            <p>Enter the verification code from your email.</p>
        </div>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-wrap">
            <h2 class="auth-title">Reset password</h2>
            <p class="auth-subtitle">Use the 6-digit code we emailed you.</p>

            <form id="reset-form" class="auth-form">
                <div id="reset-form-alert" class="form-alert d-none" role="alert"></div>
                <div class="form-group">
                    <label class="form-label">Username or email</label>
                    <input required type="text" name="login" autocomplete="username" placeholder="yourname or you@example.com" class="form-control" />
                    <p class="field-error d-none" data-error-for="login"></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Verification code</label>
                    <input required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="code" autocomplete="one-time-code" placeholder="123456" class="form-control" />
                    <p class="field-error d-none" data-error-for="code"></p>
                </div>
                <div class="form-group">
                    <label class="form-label">New password</label>
                    <input required minlength="6" type="password" name="newPassword" autocomplete="new-password" placeholder="At least 6 characters" class="form-control" />
                    <p class="field-error d-none" data-error-for="newPassword"></p>
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm password</label>
                    <input required minlength="6" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Repeat password" class="form-control" />
                    <p class="field-error d-none" data-error-for="confirmPassword"></p>
                </div>
                <button type="submit" class="btn btn-primary btn-auth">Update password</button>
            </form>

            <p class="text-muted" style="text-align:center;margin-top:1.25rem;font-size:0.88rem">
                <a asp-controller="Auth" asp-action="Login" style="color:var(--accent);font-weight:600">Back to sign in</a>
            </p>
        </div>
    </section>
</div>
<div id="toast-host" class="toast-host"></div>
<script src="~/js/reset-password.js" asp-append-version="true"></script>
</body>
</html>
