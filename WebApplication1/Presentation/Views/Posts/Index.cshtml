@model PostsIndexViewModel
@{ ViewData["Title"] = "Feed"; }
<div class="container-fluid container-xxl py-4 py-lg-5"><div class="row justify-content-center g-4"><aside class="col-lg-3 d-none d-lg-block"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><p class="small text-uppercase text-muted fw-semibold mb-3">Your space</p><a class="d-flex align-items-center gap-2 text-decoration-none text-dark" asp-controller="Profile" asp-action="Index"><span class="avatar avatar-md">@User.Identity?.Name?.FirstOrDefault()</span><span><strong>My profile</strong><small class="d-block text-muted">View your activity</small></span></a><hr/><a class="d-block py-2 text-decoration-none text-secondary" asp-controller="Friendships" asp-action="Pending"><i class="fa-solid fa-user-group me-2"></i>Friend requests</a></div></div></aside><section class="col-12 col-lg-6"><div class="d-flex align-items-end justify-content-between mb-3"><div><p class="text-primary fw-semibold small text-uppercase mb-1">Community</p><h1 class="h3 mb-0 fw-bold">Your feed</h1></div></div>
<div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body p-3 p-md-4"><div class="d-flex gap-3"><span class="avatar avatar-md">@User.Identity?.Name?.FirstOrDefault()</span><button class="btn btn-light text-start flex-grow-1 rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createPostModal">What would you like to share?</button></div></div></div>
@if (Model.Posts.Any()) { foreach (var post in Model.Posts) { <partial name="_PostCard" model="post" /> } } else { <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-5 text-center"><i class="fa-regular fa-newspaper fa-2x text-primary mb-3"></i><h2 class="h5">Your feed is waiting for an update.</h2><p class="text-muted mb-0">Share a thought or connect with people to see their posts here.</p></div></div> }
</section><aside class="col-lg-3 d-none d-lg-block"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><p class="small text-uppercase text-muted fw-semibold">Connectly tip</p><p class="small text-secondary mb-0">Use Friends Only when an update is meant for your trusted circle.</p></div></div></aside></div></div>
<div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 rounded-4 shadow"><form asp-action="Create" asp-controller="Posts" method="post"><div class="modal-header border-0"><h2 class="modal-title h5">Create post</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><textarea asp-for="CreatePost.Content" class="form-control" rows="6" placeholder="Share an update with your network…"></textarea><span asp-validation-for="CreatePost.Content" class="text-danger small"></span><div class="row g-3 mt-1"><div class="col-md-7"><label asp-for="CreatePost.MediaUrl" class="form-label small">Image URL <span class="text-muted">(optional)</span></label><input asp-for="CreatePost.MediaUrl" type="url" class="form-control" placeholder="https://…" /></div><div class="col-md-5"><label asp-for="CreatePost.Privacy" class="form-label small">Visibility</label><select asp-for="CreatePost.Privacy" class="form-select"><option value="Public">Public</option><option value="FriendsOnly">Friends only</option></select></div></div></div><div class="modal-footer border-0"><button class="btn btn-light rounded-pill px-4" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary rounded-pill px-4" type="submit">Publish post</button></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script>
(() => { const token=localStorage.getItem('accessToken'), safe=v=>{const e=document.createElement('span');e.textContent=v||'';return e.innerHTML}, headers={Authorization:`Bearer ${token}`};
document.querySelectorAll('.post-like').forEach(button=>button.addEventListener('click',async()=>{try{const wasLiked=button.classList.contains('text-danger'),r=await fetch(`/api/posts/${button.dataset.postId}/like`,{method:'POST',headers});const p=await r.json();if(!r.ok)throw Error(p.message);const liked=p.data;button.classList.toggle('text-danger',liked);button.querySelector('i').className=liked?'fa-solid fa-heart':'fa-regular fa-heart';const count=button.querySelector('span');count.textContent=Math.max(0,Number(count.textContent)+(liked===wasLiked?0:liked?1:-1));}catch(e){alert(e.message||'Unable to update this like.')}}));
document.querySelectorAll('.collapse[id^="comments-"]').forEach(panel=>panel.addEventListener('show.bs.collapse',async()=>{const postId=panel.id.replace('comments-',''),host=panel.querySelector('[data-comments-for]');if(host.dataset.loaded)return;try{const r=await fetch(`/api/posts/${postId}/comments`,{headers}),p=await r.json();if(!r.ok)throw Error(p.message);host.innerHTML=(p.data||[]).map(c=>`<div class="d-flex gap-2 mb-2"><span class="avatar avatar-sm">${safe(c.authorName.charAt(0))}</span><div class="bg-light rounded-4 px-3 py-2 small"><strong>${safe(c.authorName)}</strong><br/>${safe(c.content)}</div></div>`).join('')||'<small class="text-muted">No comments yet.</small>';host.dataset.loaded='1';}catch(e){host.innerHTML='<small class="text-danger">Comments could not be loaded.</small>';}}));
document.querySelectorAll('.comment-form').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const input=form.elements.content,content=input.value.trim();if(!content)return;try{const r=await fetch(`/api/posts/${form.dataset.postId}/comments`,{method:'POST',headers:{...headers,'Content-Type':'application/json'},body:JSON.stringify({content})}),p=await r.json();if(!r.ok)throw Error(p.message);const c=p.data,host=form.parentElement.querySelector('[data-comments-for]');host.querySelector('.text-muted')?.remove();host.insertAdjacentHTML('beforeend',`<div class="d-flex gap-2 mb-2"><span class="avatar avatar-sm">${safe(c.authorName.charAt(0))}</span><div class="bg-light rounded-4 px-3 py-2 small"><strong>${safe(c.authorName)}</strong><br/>${safe(c.content)}</div></div>`);const count=document.querySelector(`#post-${form.dataset.postId} [data-comment-count]`);count.textContent=Number(count.textContent)+1;input.value='';}catch(err){alert(err.message||'Unable to add this comment.');}}));
})();
</script> }
