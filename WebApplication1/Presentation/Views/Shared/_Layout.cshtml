<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Connectly</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/connectly.css" asp-append-version="true" />
</head>
<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<div class="app-shell">
    <header class="mobile-header" aria-label="Mobile navigation">
        <button type="button" id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Open menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <a asp-controller="Feed" asp-action="Index" class="mobile-brand">
            <span class="brand-icon">C</span>
            <span>Connectly</span>
        </a>
        <button type="button" id="mobile-header-create-post" class="mobile-header-action primary" aria-label="Create post">
            <i class="fa-solid fa-plus"></i>
        </button>
    </header>
    <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>
    <aside class="sidebar">
        <a asp-controller="Feed" asp-action="Index" class="sidebar-brand">
            <span class="brand-icon">C</span>
            <div class="brand-text">
                <h1>Connectly</h1>
                <p>Social Management</p>
            </div>
        </a>
        <nav class="sidebar-nav">
            <a class="nav-link @(controller == "Feed" ? "active" : "")" asp-controller="Feed" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a>
            <a class="nav-link @(controller == "Search" ? "active" : "")" asp-controller="Search" asp-action="Index"><i class="fa-solid fa-compass"></i> Explore</a>
            <a class="nav-link @(controller == "Chat" ? "active" : "")" asp-controller="Chat" asp-action="Index"><i class="fa-solid fa-comment-dots"></i> Messages</a>
            <div class="notif-dropdown">
                <a class="nav-link @(controller == "Notifications" ? "active" : "")" href="#" id="notification-toggle" role="button" aria-expanded="false" aria-controls="notification-menu">
                    <i class="fa-regular fa-bell"></i> Notifications <span id="notification-badge" class="nav-badge d-none">0</span>
                </a>
                <div id="notification-menu" class="notif-menu" role="menu">
                    <div class="notif-header">
                        <span>Notifications</span>
                        <a href="#" id="mark-notifications-read" class="text-primary" style="font-size:0.82rem">Mark all read</a>
                    </div>
                    <div id="notification-list"><div class="notif-item notif-empty text-muted" style="justify-content:center">No new notifications.</div></div>
                    <div class="notif-footer">
                        <a asp-controller="Notifications" asp-action="Index" class="notif-see-all">See all notifications</a>
                    </div>
                </div>
            </div>
            <a class="nav-link @(controller == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index"><i class="fa-regular fa-user"></i> Profile</a>
            <a class="nav-link @(controller == "Friendships" ? "active" : "")" asp-controller="Friendships" asp-action="Pending"><i class="fa-solid fa-user-group"></i> Friend Requests</a>
        </nav>
        <div class="sidebar-footer">
            <button type="button" id="sidebar-create-post" class="btn-create-post"><i class="fa-solid fa-plus"></i> Create Post</button>
            <a asp-controller="Profile" asp-action="Index" class="sidebar-user">
                <span id="sidebar-user-avatar" class="avatar avatar-sm">Y</span>
                <span id="sidebar-user-name" style="font-size:0.85rem;font-weight:500">Your profile</span>
            </a>
            <button type="button" id="logout-btn" class="btn btn-light btn-sm w-100 mt-3">Sign out</button>
        </div>
    </aside>
    <div class="main-content">
        @RenderBody()
    </div>
    <nav class="mobile-bottom-nav" aria-label="Primary">
        <a class="mobile-nav-item @(controller == "Feed" ? "active" : "")" asp-controller="Feed" asp-action="Index">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>
        <a class="mobile-nav-item @(controller == "Search" ? "active" : "")" asp-controller="Search" asp-action="Index">
            <i class="fa-solid fa-compass"></i>
            <span>Explore</span>
        </a>
        <a class="mobile-nav-item @(controller == "Chat" ? "active" : "")" asp-controller="Chat" asp-action="Index">
            <i class="fa-solid fa-comment-dots"></i>
            <span>Messages</span>
        </a>
        <a class="mobile-nav-item @(controller == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index">
            <i class="fa-regular fa-bell"></i>
            <span>Alerts</span>
            <span id="mobile-notification-badge" class="mobile-nav-badge d-none">0</span>
        </a>
        <a class="mobile-nav-item @(controller == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
            <i class="fa-regular fa-user"></i>
            <span>Profile</span>
        </a>
    </nav>
</div>

<div id="create-post-modal" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h2>Create post</h2>
            <button type="button" class="btn-close" aria-label="Close">&times;</button>
        </div>
        <form id="create-post-form" enctype="multipart/form-data">
            <div class="modal-body">
                <textarea name="content" maxlength="5000" class="form-control" rows="4" placeholder="What's on your mind?"></textarea>
                <div id="post-media-preview" class="post-media-preview d-none"></div>
                <div class="post-composer-actions">
                    <label class="media-picker-btn" for="post-media-file">
                        <i class="fa-solid fa-image"></i> Photo / Video
                    </label>
                    <input type="file" id="post-media-file" name="media" class="d-none" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,video/x-m4v,.mp4,.webm,.mov,.m4v" />
                    <select name="privacy" class="form-control" style="width:auto;min-width:130px">
                        <option value="0">Public</option>
                        <option value="2">Friends only</option>
                        <option value="1">Only me</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-close-modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Publish post</button>
            </div>
        </form>
    </div>
</div>

<div id="share-post-modal" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h2>Share post</h2>
            <button type="button" class="btn-close" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="share-tabs">
                <button type="button" class="share-tab active" data-share-tab="feed"><i class="fa-solid fa-house"></i> Share to profile</button>
                <button type="button" class="share-tab" data-share-tab="chat"><i class="fa-solid fa-comment-dots"></i> Send in message</button>
            </div>
            <div id="share-feed-panel" class="share-panel">
                <textarea id="share-caption" class="form-control" rows="3" maxlength="2000" placeholder="Say something about this post (optional)…"></textarea>
                <select id="share-privacy" class="form-control mt-2" style="width:auto;min-width:140px">
                    <option value="0">Public</option>
                    <option value="2">Friends only</option>
                    <option value="1">Only me</option>
                </select>
                <button type="button" id="share-to-feed-btn" class="btn btn-primary w-100 mt-3">Share to your profile</button>
            </div>
            <div id="share-chat-panel" class="share-panel d-none">
                <select id="share-friend-select" class="form-control">
                    <option value="">Loading friends…</option>
                </select>
                <textarea id="share-chat-message" class="form-control mt-2" rows="2" maxlength="500" placeholder="Add a message (optional)…"></textarea>
                <button type="button" id="share-to-chat-btn" class="btn btn-primary w-100 mt-3">Send in message</button>
            </div>
        </div>
    </div>
</div>

<div id="post-likes-modal" class="modal-overlay">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h2>Likes</h2>
            <button type="button" class="btn-close" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body" id="post-likes-list" style="padding:0;max-height:22rem;overflow-y:auto"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" referrerpolicy="no-referrer"></script>
<script src="~/js/connectly.js" asp-append-version="true"></script>
<script>
document.querySelectorAll('.btn-close-modal').forEach(b => b.addEventListener('click', () => document.getElementById('create-post-modal')?.classList.remove('open')));
document.getElementById('share-post-modal')?.querySelector('.btn-close')?.addEventListener('click', () => document.getElementById('share-post-modal')?.classList.remove('open'));
document.getElementById('post-likes-modal')?.querySelector('.btn-close')?.addEventListener('click', () => document.getElementById('post-likes-modal')?.classList.remove('open'));
document.getElementById('post-likes-modal')?.addEventListener('click', e => { if (e.target.id === 'post-likes-modal') e.currentTarget.classList.remove('open'); });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
